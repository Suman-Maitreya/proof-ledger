# PayPal Sandbox credentials — get from https://developer.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Frontend URLs for PayPal redirect
FRONTEND_URL=http://localhost:5173

# AI Oracle — OpenAI (GPT-4o vision) or leave blank for mock mode
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# If OPENAI_API_KEY is empty, oracle runs in MOCK mode (always returns a PASS score for demo)
AI_MOCK_MODE=true

PORT=4000
